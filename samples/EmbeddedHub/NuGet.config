<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Local pack output (eng/PackLibraries.ps1). Real consumers use the Wixely feed instead:
         https://nuget.pkg.github.com/Wixely/index.json with a read:packages PAT. -->
    <add key="mcphub-local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
