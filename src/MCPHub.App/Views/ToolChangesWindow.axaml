<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MCPHub.App.ViewModels"
        x:Class="MCPHub.App.Views.ToolChangesWindow"
        x:DataType="vm:ToolChangesViewModel"
        Title="{Binding Title}"
        Width="620" Height="520" MinWidth="420" MinHeight="260"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,14">
      <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Opacity="0.65" FontSize="12"
                 IsVisible="{Binding HasNote}"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Close" Click="OnClose" IsDefault="True" IsCancel="True"/>
    </StackPanel>

    <ScrollViewer IsVisible="{Binding HasRows}">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ToolChangeRow">
            <Border BorderBrush="#22808080" BorderThickness="0,0,0,1" Padding="0,10">
              <Grid ColumnDefinitions="84,*" ColumnSpacing="12">
                <Border Grid.Column="0" Background="{Binding KindBrush}" CornerRadius="4" Padding="6,2"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                  <TextBlock Text="{Binding KindText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                             FontFamily="Cascadia Mono,Consolas,monospace" TextWrapping="Wrap"/>
                  <ItemsControl ItemsSource="{Binding Details}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Opacity="0.8" FontSize="12" Margin="0,1"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
