<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MCPHub.App.ViewModels"
             x:Class="MCPHub.App.Views.PermissionsView"
             x:DataType="vm:PermissionsViewModel">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PermissionsCardBackground" Color="#08000000"/>
          <SolidColorBrush x:Key="PermissionsCardBorder" Color="#40000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PermissionsCardBackground" Color="#10FFFFFF"/>
          <SolidColorBrush x:Key="PermissionsCardBorder" Color="#40FFFFFF"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="Permissions" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Which tools each user may use. Users and their keys are on the Users page — one key reaches every surface."
                 Opacity="0.65" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold"/>
    </StackPanel>
    <ScrollViewer>
      <StackPanel Spacing="18">

        <Border IsVisible="{Binding HasConfigurationError}" Background="#33F85149" BorderBrush="#66F85149"
                BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel Spacing="4">
            <TextBlock Text="Permissions are not loaded" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ConfigurationError}" TextWrapping="Wrap"/>
            <TextBlock Text="No user is granted any tool while this stands, and changes here will not save — the existing file is left untouched rather than overwritten."
                       FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <TextBlock IsVisible="{Binding HasNoRows}" Opacity="0.7" TextWrapping="Wrap"
                   Text="No users yet. Add one on the Users page to issue a key, then grant it tools here."/>

        <ListBox IsVisible="{Binding HasRows}" ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding SelectedUser}" MaxHeight="240">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GrantRow">
              <Grid ColumnDefinitions="2*,Auto,4*" ColumnSpacing="12">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding State}" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Summary}" Opacity="0.75"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border IsVisible="{Binding HasUserSelected}" Background="{DynamicResource PermissionsCardBackground}"
                BorderBrush="{DynamicResource PermissionsCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding EditorTitle}" FontWeight="SemiBold"/>
            <Border IsVisible="{Binding HasSelectedUserWarning}" Background="#33D29922" BorderBrush="#66D29922"
                    BorderThickness="1" CornerRadius="6" Padding="10">
              <TextBlock Text="{Binding SelectedUserWarning}" TextWrapping="Wrap"/>
            </Border>
            <TextBlock Text="Tool grants, one per line"/>
            <TextBox Text="{Binding Grants}" AcceptsReturn="True" MinHeight="100"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     Watermark="kodi__play_pause&#x0a;redis__*&#x0a;*"/>
            <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                       Text="An exact tool name, every tool of one server (redis__*), or everything (*). Use * only for an application you trust to administer this hub: it covers servers that are not installed yet, which is what makes installing possible, and it covers the users__ and permissions__ tools too."/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Save grants" Command="{Binding SaveCommand}"/>
              <Button Content="Revoke all" Command="{Binding RevokeAllCommand}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource PermissionsCardBackground}" CornerRadius="8" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Why can this user not use a tool?" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                       Text="A tool can be withheld by a grant, by a suspended user, and by a feature switch at the same time — and an environment variable can be pinning any of them. Granting the tool then changes nothing, which looks like the grant failed. This lists every reason at once."/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding ExplainTool}" Watermark="A tool name as the proxy advertises it, e.g. mcphub__install"/>
              <Button Grid.Column="1" Content="Explain" Command="{Binding ExplainCommand}"/>
            </Grid>
            <TextBlock IsVisible="{Binding HasExplanation}" Text="{Binding ExplainSummary}" TextWrapping="Wrap" FontWeight="SemiBold"/>
            <ItemsControl IsVisible="{Binding HasDenials}" ItemsSource="{Binding Denials}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PermissionsDenialRow">
                  <Border Background="#1AF85149" BorderBrush="#40F85149" BorderThickness="1" CornerRadius="6"
                          Padding="12" Margin="0,0,0,8">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                      <TextBlock IsVisible="{Binding HasRemedy}" Text="{Binding Remedy}" TextWrapping="Wrap" Opacity="0.8"/>
                      <TextBlock IsVisible="{Binding IsPinned}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12"
                                 Text="{Binding PinnedBy, StringFormat='Forced by the environment: {0} — changing the setting here will not help.'}"/>
                      <TextBlock Text="{Binding Code}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11" Opacity="0.5"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
