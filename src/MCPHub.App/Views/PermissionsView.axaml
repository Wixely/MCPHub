<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MCPHub.App.ViewModels"
             x:Class="MCPHub.App.Views.PermissionsView"
             x:DataType="vm:PermissionsViewModel">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PermissionsCardBackground" Color="#08000000"/>
          <SolidColorBrush x:Key="PermissionsCardBorder" Color="#40000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PermissionsCardBackground" Color="#10FFFFFF"/>
          <SolidColorBrush x:Key="PermissionsCardBorder" Color="#40FFFFFF"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="Permissions" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Which tools each user may use. Users and their keys live on the Users page."
                 Opacity="0.65" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold"/>
    </StackPanel>
    <ScrollViewer>
      <StackPanel Spacing="18">

        <Border IsVisible="{Binding HasConfigurationError}" Background="#33F85149" BorderBrush="#66F85149"
                BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel Spacing="4">
            <TextBlock Text="Permissions are not loaded" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ConfigurationError}" TextWrapping="Wrap"/>
            <TextBlock Text="No user gets any tool, and nothing here will save. The file is left as it is."
                       FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <StackPanel IsVisible="{Binding HasNoRows}" Spacing="8" HorizontalAlignment="Left">
          <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="No users yet. Add one, then grant it tools here."/>
          <Button Content="Add a user" Command="{Binding AddUserCommand}"/>
        </StackPanel>

        <ListBox IsVisible="{Binding HasRows}" ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding SelectedUser}" MaxHeight="240">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GrantRow">
              <Grid ColumnDefinitions="2*,Auto,4*" ColumnSpacing="12">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding State}" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Summary}" Opacity="0.75"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border IsVisible="{Binding HasUserSelected}" Background="{DynamicResource PermissionsCardBackground}"
                BorderBrush="{DynamicResource PermissionsCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding EditorTitle}" FontWeight="SemiBold"/>
            <Border IsVisible="{Binding HasSelectedUserWarning}" Background="#33D29922" BorderBrush="#66D29922"
                    BorderThickness="1" CornerRadius="6" Padding="10">
              <TextBlock Text="{Binding SelectedUserWarning}" TextWrapping="Wrap"/>
            </Border>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <ToggleSwitch IsChecked="{Binding IsAdvanced}" OffContent="Services" OnContent="Every tool"/>
              <TextBlock Grid.Column="1" Text="{Binding ModeText}" VerticalAlignment="Center" Opacity="0.65" FontSize="12"/>
            </Grid>

            <CheckBox IsChecked="{Binding GrantEverything}" Content="Everything, including services added later"/>

            <!-- Simple: one checkbox per service. -->
            <ItemsControl IsVisible="{Binding !IsAdvanced}" ItemsSource="{Binding Groups}" IsEnabled="{Binding !GrantEverything}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolGroupRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,2">
                    <CheckBox IsChecked="{Binding IsGranted}" Content="{Binding DisplayName}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Summary}" Opacity="0.6" FontSize="12" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Advanced: every tool, with a filter, multi-select and space to toggle. -->
            <StackPanel IsVisible="{Binding IsAdvanced}" Spacing="8" IsEnabled="{Binding !GrantEverything}">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding ToolFilter}" Watermark="Filter by tool or service"/>
                <Button Grid.Column="1" Content="Select all" Command="{Binding SelectAllToolsCommand}"/>
                <Button Grid.Column="2" Content="Select none" Command="{Binding SelectNoToolsCommand}"/>
              </Grid>
              <ListBox x:Name="ToolList" ItemsSource="{Binding VisibleTools}" SelectionMode="Multiple"
                       MaxHeight="320" KeyDown="OnToolListKeyDown">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ToolRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <CheckBox IsChecked="{Binding IsGranted}"/>
                      <TextBlock Grid.Column="1" Text="{Binding ShortName}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding GroupName}" Opacity="0.6" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock IsVisible="{Binding !HasTools}" Opacity="0.7" TextWrapping="Wrap"
                         Text="No tools to show. Services offer their tools once they are connected."/>
              <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                         Text="Select rows and press Space to tick them. Ticking every tool of a service grants the service, so tools it adds later are included."/>
            </StackPanel>

            <StackPanel IsVisible="{Binding HasKeptGrants}" Spacing="4">
              <TextBlock Text="Also granted" FontWeight="SemiBold" FontSize="12"/>
              <ItemsControl ItemsSource="{Binding KeptGrants}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                      <TextBlock Text="{Binding}" FontFamily="Cascadia Mono,Consolas,monospace" VerticalAlignment="Center"/>
                      <Button Grid.Column="1" Content="Remove" FontSize="11"
                              Command="{Binding $parent[ItemsControl].((vm:PermissionsViewModel)DataContext).RemoveGrantCommand}"
                              CommandParameter="{Binding}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                         Text="Named by hand, for services that are not connected or not installed yet. Kept as typed."/>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding NewGrant}" Watermark="Add by name, e.g. kodi__* or kodi__play_pause"
                       FontFamily="Cascadia Mono,Consolas,monospace"/>
              <Button Grid.Column="1" Content="Add" Command="{Binding AddGrantCommand}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Save" Command="{Binding SaveCommand}"/>
              <Button Content="Revoke all" Command="{Binding RevokeAllCommand}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource PermissionsCardBackground}" CornerRadius="8" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Why can this user not use a tool?" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                       Text="Several things can withhold one tool at once, so fixing one changes nothing. This lists them all."/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding ExplainTool}" Watermark="Tool name, e.g. mcphub__install"/>
              <Button Grid.Column="1" Content="Explain" Command="{Binding ExplainCommand}"/>
            </Grid>
            <TextBlock IsVisible="{Binding HasExplanation}" Text="{Binding ExplainSummary}" TextWrapping="Wrap" FontWeight="SemiBold"/>
            <ItemsControl IsVisible="{Binding HasDenials}" ItemsSource="{Binding Denials}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PermissionsDenialRow">
                  <Border Background="#1AF85149" BorderBrush="#40F85149" BorderThickness="1" CornerRadius="6"
                          Padding="12" Margin="0,0,0,8">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                      <TextBlock IsVisible="{Binding HasRemedy}" Text="{Binding Remedy}" TextWrapping="Wrap" Opacity="0.8"/>
                      <TextBlock IsVisible="{Binding IsPinned}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12"
                                 Text="{Binding PinnedBy, StringFormat='Set by the environment: {0}. Changing it here will not help.'}"/>
                      <TextBlock Text="{Binding Code}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11" Opacity="0.5"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
