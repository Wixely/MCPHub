<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MCPHub.App.ViewModels"
             x:Class="MCPHub.App.Views.UsersView"
             x:DataType="vm:UsersViewModel">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="UsersCardBackground" Color="#08000000"/>
          <SolidColorBrush x:Key="UsersCardBorder" Color="#40000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="UsersCardBackground" Color="#10FFFFFF"/>
          <SolidColorBrush x:Key="UsersCardBorder" Color="#40FFFFFF"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="Users" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Who may reach this hub. A user is created once here and holds one key; what it may do is set on the Permissions page."
                 Opacity="0.65" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold"/>
    </StackPanel>
    <ScrollViewer>
      <StackPanel Spacing="18">

        <Border IsVisible="{Binding HasConfigurationError}" Background="#33F85149" BorderBrush="#66F85149"
                BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel Spacing="4">
            <TextBlock Text="Users are not loaded" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ConfigurationError}" TextWrapping="Wrap"/>
            <TextBlock Text="No key is recognised while this stands, and changes here will not save — the existing file is left untouched rather than overwritten."
                       FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding HasWarning}" Background="#33D29922" BorderBrush="#66D29922"
                BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel Spacing="4">
            <TextBlock Text="These users are not being applied" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource UsersCardBackground}" CornerRadius="8" Padding="16">
          <StackPanel Spacing="10">
            <CheckBox IsChecked="{Binding KeysEnforced}" Content="Require a key"/>
            <TextBlock Text="On, a caller with no key is refused and each key sees only what its user is allowed. Off — the default — every caller is served as the single user and gets every tool, which is how MCPHub has always behaved on its own machine."
                       FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
            <CheckBox IsChecked="{Binding AdministerThroughProxy}" IsEnabled="{Binding CanEditAdministration}"
                      Content="Let callers administer this hub through the proxy"/>
            <TextBlock Text="Exposes the users__ and permissions__ tools, so another application can manage this for you. Off by default: they govern every other tool, so a caller holding them can grant itself anything."
                       FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
            <TextBlock IsVisible="{Binding IsAdministrationPinned}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="{Binding AdministrationPinnedBy, StringFormat='Pinned by the environment: {0}. The checkbox cannot be changed while that is set.'}"/>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Users" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="Add user" Command="{Binding AddUserCommand}"/>
        </Grid>
        <TextBlock IsVisible="{Binding HasNoUsers}" Opacity="0.7" TextWrapping="Wrap"
                   Text="No users yet. Add one to issue a key — until then, and while a key is not required, every caller gets every tool."/>
        <ListBox IsVisible="{Binding HasUsers}" ItemsSource="{Binding Users}"
                 SelectedItem="{Binding SelectedUser}" MaxHeight="260">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:UserRow">
              <Grid ColumnDefinitions="3*,Auto,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding State}" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding KeyFingerprint}" Opacity="0.5" VerticalAlignment="Center"
                           FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="Editor" IsVisible="{Binding IsEditorOpen}" Background="{DynamicResource UsersCardBackground}"
                BorderBrush="{DynamicResource UsersCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding EditorTitle}" FontWeight="SemiBold"/>
            <TextBox Watermark="Name — an agent's nickname, or the application holding the key"
                     Text="{Binding UserName}"/>
            <CheckBox IsChecked="{Binding UserEnabled}" Content="Enabled"/>
            <TextBlock Text="Suspending stops this key everywhere at once and keeps everything else, so it can be restored exactly as it was. To a caller it is indistinguishable from a key that was never issued."
                       FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{Binding SaveText}" Command="{Binding SaveCommand}"/>
              <Button Content="Cancel" Command="{Binding CancelCommand}"/>
              <Button Content="Rotate key" Command="{Binding RotateKeyCommand}" IsVisible="{Binding HasUserSelected}"/>
              <Button Content="Remove" Command="{Binding RemoveCommand}" IsVisible="{Binding HasUserSelected}"/>
            </StackPanel>
            <TextBlock IsVisible="{Binding HasUserSelected}" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                       Text="Rotating takes effect immediately and retires the previous key. Removing also drops this user's tool grants. Neither saves the form above."/>
          </StackPanel>
        </Border>

        <Border x:Name="GeneratedKeyCard" IsVisible="{Binding HasGeneratedKey}"
                Background="{DynamicResource UsersCardBackground}" CornerRadius="6" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding GeneratedKeyNotice}" TextWrapping="Wrap"/>
            <TextBox Text="{Binding GeneratedKey, Mode=OneWay}" IsReadOnly="True" PasswordChar="●"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Copy new key" Click="OnCopyKey"/>
              <Button Content="Dismiss key" Command="{Binding DismissKeyCommand}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
