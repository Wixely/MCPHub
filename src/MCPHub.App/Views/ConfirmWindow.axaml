<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="using:MCPHub.App.Infrastructure"
        x:Class="MCPHub.App.Views.ConfirmWindow"
        x:DataType="inf:ConfirmRequest"
        Title="{Binding Title}"
        Width="460" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{Binding CancelText}" Click="OnCancel" IsCancel="True"/>
      <Button Content="{Binding ConfirmText}" Click="OnConfirm" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
