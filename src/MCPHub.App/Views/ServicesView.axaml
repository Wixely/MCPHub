<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MCPHub.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="560"
             x:Class="MCPHub.App.Views.ServicesView"
             x:DataType="vm:ServicesViewModel">

  <DockPanel Margin="24">

    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,12">
      <TextBlock Text="Managed MCP Servers" FontSize="20" FontWeight="SemiBold"/>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="The Wixely MCPSharp suite — " Opacity="0.65" VerticalAlignment="Center"/>
        <HyperlinkButton Content="GitHub"
                         NavigateUri="https://github.com/Wixely/MCPHub"
                         Padding="0" VerticalAlignment="Center"/>
      </StackPanel>
    </StackPanel>

    <!-- Toolbar -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,12" ColumnDefinitions="Auto,Auto,*">
      <Button Grid.Column="0"
              Content="Check for updates"
              Command="{Binding CheckAllUpdatesCommand}"
              IsEnabled="{Binding !IsChecking}"/>
      <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="120" Height="4"
                   Margin="14,0" VerticalAlignment="Center"
                   IsVisible="{Binding IsChecking}"/>
      <TextBlock Grid.Column="2" Text="{Binding StatusMessage}"
                 VerticalAlignment="Center" Opacity="0.7"
                 TextTrimming="CharacterEllipsis"/>
    </Grid>

    <!-- Search: narrows the list as you type -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,10" ColumnDefinitions="*,Auto,Auto">
      <TextBox Grid.Column="0"
               Watermark="Search servers by name…"
               Text="{Binding FilterText}"
               ToolTip.Tip="Matches the display name or the product name, e.g. 'mail' or 'mailcal'"/>
      <Button Grid.Column="1" Content="Clear" Margin="8,0,0,0"
              Command="{Binding ClearFilterCommand}"
              IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <TextBlock Grid.Column="2" Text="{Binding FilterSummary}"
                 Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.6"/>
    </Grid>

    <!-- Column header -->
    <Border DockPanel.Dock="Top" Background="#14000000" CornerRadius="6,6,0,0" Padding="14,9">
      <Grid ColumnDefinitions="*,52,80,88,96,52,354">
        <TextBlock Grid.Column="0" Text="Service" FontWeight="SemiBold"/>
        <TextBlock Grid.Column="1" Text="Port" FontWeight="SemiBold"/>
        <TextBlock Grid.Column="2" Text="Installed" FontWeight="SemiBold"/>
        <TextBlock Grid.Column="3" Text="Latest" FontWeight="SemiBold"/>
        <TextBlock Grid.Column="4" Text="State" FontWeight="SemiBold"/>
        <TextBlock Grid.Column="5" Text="Auto" FontWeight="SemiBold" ToolTip.Tip="Start automatically when MCPHub launches"/>
        <TextBlock Grid.Column="6" Text="Actions" FontWeight="SemiBold"/>
      </Grid>
    </Border>

    <!-- Shown instead of an unexplained empty list when the filter matches nothing -->
    <TextBlock DockPanel.Dock="Top" Margin="14,16,0,0" Opacity="0.6"
               IsVisible="{Binding HasNoMatches}"
               Text="No servers match that name."/>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding FilteredServices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ManagedServiceViewModel">
            <Border BorderBrush="#18000000" BorderThickness="0,0,0,1" Padding="14,8">
              <Grid ColumnDefinitions="*,52,80,88,96,52,354" VerticalAlignment="Center">

                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Description}" Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding PortText}" VerticalAlignment="Center" Opacity="0.85"/>
                <TextBlock Grid.Column="2" Text="{Binding InstalledVersion}" VerticalAlignment="Center" Opacity="0.85"/>

                <!-- Latest + update-status dot -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding UpdateStatusText}">
                  <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                          Background="{Binding UpdateStatus, Converter={StaticResource UpdateStatusToBrush}}"/>
                  <TextBlock Text="{Binding LatestVersion}" Opacity="0.85"/>
                </StackPanel>

                <!-- Run state -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                  <Border Width="9" Height="9" CornerRadius="5" VerticalAlignment="Center"
                          Background="{Binding RunState, Converter={StaticResource RunStateToBrush}}"/>
                  <TextBlock Text="{Binding RunStateText}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Auto-run at launch -->
                <CheckBox Grid.Column="5" IsChecked="{Binding AutoRun}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          ToolTip.Tip="Start this service automatically when MCPHub launches"/>

                <!-- Actions -->
                <Panel Grid.Column="6">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                              IsVisible="{Binding !IsInstalling}">
                    <Button Content="{Binding InstallButtonText}" Width="84" HorizontalContentAlignment="Center" Padding="8,4" Command="{Binding InstallCommand}"/>
                    <Button Content="{Binding StartButtonText}" Width="66" HorizontalContentAlignment="Center" Padding="8,4"
                            Command="{Binding StartOrRestartCommand}" IsEnabled="{Binding CanStartOrRestart}"
                            ToolTip.Tip="Start the service, or stop and start it again if it's already running"/>
                    <Button Content="Stop" Width="56" HorizontalContentAlignment="Center" Padding="8,4" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"/>
                    <!-- Single-config services: opens {Name}.json directly. -->
                    <Button Content="Config" Width="64" HorizontalContentAlignment="Center" Padding="8,4"
                            IsVisible="{Binding !HasExtraConfigs}"
                            Command="{Binding EditConfigCommand}"
                            IsEnabled="{Binding CanEditConfig}" ToolTip.Tip="{Binding ConfigFileName}"/>

                    <!-- Multi-config services (e.g. Remote Admin): pick which file to open. -->
                    <Button Content="Config ⌄" Width="64" HorizontalContentAlignment="Center" Padding="8,4"
                            IsVisible="{Binding HasExtraConfigs}"
                            IsEnabled="{Binding CanOpenConfigMenu}"
                            ToolTip.Tip="This service reads several config files">
                      <Button.Flyout>
                        <MenuFlyout ItemsSource="{Binding ConfigFiles}">
                          <MenuFlyout.ItemContainerTheme>
                            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                          x:DataType="vm:ConfigFileViewModel">
                              <Setter Property="Header" Value="{Binding DisplayName}"/>
                              <Setter Property="Command" Value="{Binding OpenCommand}"/>
                              <Setter Property="ToolTip.Tip" Value="{Binding ToolTip}"/>
                            </ControlTheme>
                          </MenuFlyout.ItemContainerTheme>
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                    <Button Content="Logs" Width="56" HorizontalContentAlignment="Center" Padding="8,4" Command="{Binding ViewLogsCommand}"/>
                  </StackPanel>
                  <ProgressBar IsVisible="{Binding IsInstalling}" Minimum="0" Maximum="1"
                               Value="{Binding InstallProgress}" Height="8" VerticalAlignment="Center"/>
                </Panel>

              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </DockPanel>
</UserControl>
