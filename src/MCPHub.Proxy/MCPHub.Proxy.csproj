<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MCPHub.Proxy</RootNamespace>
    <AssemblyName>MCPHub.Proxy</AssemblyName>
    <MCPHubPackable>true</MCPHubPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>MCPHub.Proxy</PackageId>
    <Description>Embeddable MCP aggregation core: an upstream MCP client pool (HTTP and stdio), an atomically swapped namespaced tool catalog, routing handlers, and a multi-tenant authorization + audit seam (per-tenant tools/list filtering, call authorization, digest-only audit events).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

</Project>
