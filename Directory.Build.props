<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.7.0</Version>
    <Authors>Wixely Holmes</Authors>
    <Product>MCPHub</Product>
    <Company>Wixely Holmes</Company>
    <Copyright>Copyright (c) 2026 Wixely Holmes</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Wixely/MCPHub</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Wixely/MCPHub</PackageProjectUrl>
    <!-- Only projects that opt in via MCPHubPackable produce packages (see Directory.Build.targets). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
